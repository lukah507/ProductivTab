{
  "manifest_version": 3,
  "name": "ProductivTab",
  "version": "1.0.0",
  "description": "A new tab with customizable top/bottom bars, backgrounds, quotes, time, and sticky notes.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "favicon",
    "unlimitedStorage"
  ],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}